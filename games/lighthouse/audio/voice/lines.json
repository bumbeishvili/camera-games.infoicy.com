  {"id": "kit-ask", "text": "Kit here! I’m lost in the dark! Wipe it clean!", "ka": "კიტი ვარ! სიბნელეში დავიკარგე! გაწმინდე ფანჯარა!", "voice": "af_nicole", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 6},
