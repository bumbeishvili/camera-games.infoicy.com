[
  {"id": "joze-mission", "text": "Pirates want our treasure! Help me drive them off!", "ka": "მეკობრეებს ჩვენი განძი უნდათ! დამეხმარე, გავყაროთ ისინი!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-open", "text": "Open your hand to raise the sails!", "ka": "გაშალე ხელი, რომ იალქნები ავწიოთ!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-wheel", "text": "Move your hand side to side to turn the wheel!", "ka": "ამოძრავე ხელი მარცხნივ და მარჯვნივ, რომ საჭე მოაბრუნო!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-beside", "text": "Sail beside them! The cannons fire by themselves!", "ka": "გვერდით მიუცურე! ზარბაზნები თავისით ისვრიან!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-bye", "text": "Bye bye! They’re rowing home!", "speak": "Bye bye! They're rowing home!", "ka": "ნახვამდის! ნავით სახლში ბრუნდებიან!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-one-left", "text": "One more to go!", "ka": "კიდევ ერთი დარჩა!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-back", "text": "Back to the island!", "ka": "კუნძულისკენ დაბრუნდი!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-won", "text": "You drove them all off! The treasure is safe!", "ka": "ყველა გააძევე! განძი უსაფრთხოდაა!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "joze-lost", "text": "So close! Sail again!", "ka": "ცოტაც და! კიდევ სცადე!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "captain-truffle", "text": "Oink! That treasure smells delicious!", "ka": "ღრუტ! ამ განძს გემრიელი სუნი აქვს!", "voice": "am_puck", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 12},
  {"id": "captain-kit", "text": "Kit here! Your treasure is mine!", "ka": "კიტი ვარ! შენი განძი ჩემია!", "voice": "af_nicole", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 6},
  {"id": "captain-mochi", "text": "Hop hop! Hand over the treasure!", "ka": "ხტუნვა, ხტუნვა! განძი მომეცი!", "voice": "af_sky", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 24},
  {"id": "captain-widget", "text": "Beep! Treasure found! Boop!", "ka": "ბიპ! განძი ვიპოვე! ბუპ!", "voice": "am_echo", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": -6},
  {"id": "captain-frost", "text": "Frost here! Let’s have a snowball fight!", "speak": "Frost here! Let's have a snowball fight!", "ka": "ფროსტი ვარ! მოდი, გუნდაობა ვითამაშოთ!", "voice": "bf_emma", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 18},
  {"id": "captain-bramble", "text": "Bramble here! Is the treasure honey?", "ka": "ბრემბლი ვარ! განძი თაფლია?", "voice": "bm_george", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": -18},
  {"id": "captain-nova", "text": "Meow! That treasure shines like the stars!", "ka": "მიაუ! ეს განძი ვარსკვლავებივით ბრწყინავს!", "voice": "af_bella", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 12},
  {"id": "captain-cinder", "text": "Cinder here! I’m all fired up!", "speak": "Cinder here! I'm all fired up!", "ka": "სინდერი ვარ! ცეცხლივით მზად ვარ!", "voice": "am_adam", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 6},
  {"id": "captain-tur", "text": "Tur here! Nobody sails like a mountain goat!", "ka": "ჯიხვი ვარ! ჯიხვივით ვერავინ ცურავს!", "voice": "bm_lewis", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": -6}
