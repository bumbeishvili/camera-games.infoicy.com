  {"id": "thanks-giraffe", "text": "Thank you! You’re so strong!", "speak": "Thank you! You're so strong!", "ka": "გმადლობ! რა ძლიერი ხარ!", "voice": "am_michael", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": 0},
  {"id": "thanks-truffle", "text": "Oink! I’m free!", "speak": "Oink! I'm free!", "ka": "ღრუტ! თავისუფალი ვარ!", "voice": "am_puck", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 12},
