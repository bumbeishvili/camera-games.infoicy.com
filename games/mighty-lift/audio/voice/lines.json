  {"id": "thanks-mochi", "text": "Hooray! I can hop again!", "ka": "ვაშა! ისევ შემიძლია ხტუნვა!", "voice": "af_sky", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 24},
  {"id": "thanks-widget", "text": "Beep boop! Thank you!", "ka": "ბიპ-ბუპ! გმადლობ!", "voice": "am_echo", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": -6},
  {"id": "thanks-frost", "text": "Brr! That was heavy!", "ka": "ბრრ! რა მძიმე იყო!", "voice": "bf_emma", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 18},
  {"id": "thanks-bramble", "text": "A big bear thank you!", "ka": "დიდი დათვური მადლობა!", "voice": "bm_george", "kaVoice": "ka-GE-GiorgiNeural", "kaPitch": -18},
  {"id": "thanks-nova", "text": "Meow! You’re a star!", "speak": "Meow! You're a star!", "ka": "მიაუ! ნამდვილი ვარსკვლავი ხარ!", "voice": "af_bella", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 12},
  {"id": "thanks-cinder", "text": "Phew! Thank you!", "ka": "უჰ! გმადლობ!", "voice": "am_adam", "kaVoice": "ka-GE-EkaNeural", "kaPitch": 6},
