[
  {"id": "choose", "text": "Who’s lifting today?", "speak": "Who's lifting today?", "ka": "დღეს ვინ ასწევს სიმძიმეს?"},
  {"id": "mission", "text": "Lift it up and set them free!", "ka": "ასწიე მაღლა და მეგობრები გაათავისუფლე!"},
  {"id": "warm-one", "text": "Raise your arm as high as you can!", "ka": "ასწიე ხელი, რაც შეგიძლია მაღლა!"},
  {"id": "warm-both", "text": "Raise both arms as high as you can!", "ka": "ასწიე ორივე ხელი, რაც შეგიძლია მაღლა!"},
